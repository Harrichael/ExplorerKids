{erl_opts, [debug_info]}.

{deps, [{cowboy, "~> 2.12"}]}.

{shell, [{config, "config/sys.config"}, {apps, [lantern_hill]}]}.

{relx, [{release, {lantern_hill, "0.1.0"}, [lantern_hill, sasl]},
        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"},
        {mode, dev}]}.

{profiles, [{prod, [{relx, [{mode, prod}]}]}]}.
