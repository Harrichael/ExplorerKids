{erl_opts, [debug_info]}.

{deps, [{cowboy, "~> 2.12"}]}.

%% r3:compile() would otherwise reload these unchanged deps too; a second reload purges
%% the code their connection loops are running and drops every open connection.
{shell, [{config, "config/shell.config"}, {apps, [lantern_hill]},
         {app_reload_blacklist, [cowboy, cowlib, ranch]}]}.

{relx, [{release, {lantern_hill, "0.1.2"}, [lantern_hill, sasl]},
        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"},
        {mode, dev}]}.

{profiles, [{prod, [{relx, [{mode, prod}]}]}]}.
